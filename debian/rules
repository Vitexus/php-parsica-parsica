#!/usr/bin/make -f
PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_install:
	mkdir -p debian/php-parsica-parsica/usr/share/php/Parsica/Parsica
	cp -r src/. debian/php-parsica-parsica/usr/share/php/Parsica/Parsica/
	install -m 644 debian/autoload.php debian/php-parsica-parsica/usr/share/php/Parsica/Parsica/autoload.php
	sed -i "s|'unknown'|'$(PKG_SOURCE)'|" debian/php-parsica-parsica/usr/share/php/Parsica/Parsica/autoload.php
	sed -i "s|'0.0.0'|'$(PKG_VERSION)'|" debian/php-parsica-parsica/usr/share/php/Parsica/Parsica/autoload.php
